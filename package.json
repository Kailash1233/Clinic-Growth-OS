{
  "name": "clinic-growth-os",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-on-deploy.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "check:env": "tsx scripts/check-env.ts",
    "verify:integrations": "tsx scripts/verify-integrations.ts",
    "test": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:e2e": "tsx tests/e2e/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^5.18.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/smtp-server": "^3.5.13",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.41",
    "prisma": "^5.18.0",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
