# Copy to .env and fill in. See README.md "API keys required" for where to get each one.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/clinic_growth_os"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# --- Google Cloud (Places API (New) + PageSpeed Insights v5) ---
# Set a daily quota cap on both keys in Google Cloud Console before deploying (requirements §10).
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# --- OpenAI ---
# Set a monthly spend cap on this key before deploying (requirements §10).
OPENAI_API_KEY=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs created in the Razorpay dashboard (Subscriptions > Plans).
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=

# --- Cloudflare R2 (object storage) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Public base URL for the bucket (R2.dev subdomain, or a custom domain mapped to the bucket).
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# --- Cloudflare Turnstile (bot protection) ---
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Client-side copy of the site key (must be prefixed NEXT_PUBLIC_ to reach the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- OTP provider (MSG91 for SMS OTP) ---
OTP_PROVIDER_API_KEY=
MSG91_TEMPLATE_ID=

# --- Email (Resend — OTP email fallback + receipts) ---
RESEND_API_KEY=
EMAIL_FROM="Clinic Growth <noreply@yourbrand.in>"

# --- App ---
# Swap for your real domain the moment it's picked (requirements §15).
APP_BASE_DOMAIN=yourbrand.in

# --- Landing page v2 (optional — all have sensible defaults, no key required) ---
# Pill badge above the hero headline. Keep it honest — no fabricated numbers.
NEXT_PUBLIC_HERO_BADGE_TEXT="Built for Indian clinics"
# Comma-separated partner/clinic logo names for the trust-banner logo row.
# Leave unset — the row is hidden entirely (not shown empty) until this is set.
PARTNER_LOGOS=
